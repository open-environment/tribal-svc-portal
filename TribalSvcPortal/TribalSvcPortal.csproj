  </ItemGroup>

  <ItemGroup>
    <Content Update="Views\OpenDump\CleanupActual.cshtml">
      <Pack>$(IncludeRazorContentInPack)</Pack>
    </Content>
    <Content Update="Views\OpenDump\WasteContent.cshtml">
      <Pack>$(IncludeRazorContentInPack)</Pack>
    </Content>
    <Content Update="wwwroot\files\ImportColumnsConfig.xml">
